#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ ! -x "$ROOT_DIR/backend/.venv/bin/python" ]]; then
  PYTHON_BIN="${PYTHON_BIN:-python3}"
  "$PYTHON_BIN" -c 'import sys; sys.exit("Python 3.12+ is required. Set PYTHON_BIN to your Python 3.12 executable.") if sys.version_info < (3, 12) else None'
  "$PYTHON_BIN" -m venv "$ROOT_DIR/backend/.venv"
fi

"$ROOT_DIR/backend/.venv/bin/python" -m pip install -r "$ROOT_DIR/backend/requirements.txt"
npm --prefix "$ROOT_DIR/frontend" ci

echo "Environment ready. Run ./scripts/check to verify it."
