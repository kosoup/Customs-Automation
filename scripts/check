#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ ! -x "$ROOT_DIR/backend/.venv/bin/pytest" ]]; then
  echo "Backend environment is missing. Run ./scripts/bootstrap first." >&2
  exit 1
fi

if [[ ! -d "$ROOT_DIR/frontend/node_modules" ]]; then
  echo "Frontend dependencies are missing. Run ./scripts/bootstrap first." >&2
  exit 1
fi

echo "[1/3] Backend tests"
(
  cd "$ROOT_DIR/backend"
  .venv/bin/pytest
)

echo "[2/3] Frontend lint"
(
  cd "$ROOT_DIR/frontend"
  npm run lint
)

echo "[3/3] Frontend build"
(
  cd "$ROOT_DIR/frontend"
  npm run build
)

echo "All checks passed."
