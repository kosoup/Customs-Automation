#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ ! -x "$ROOT_DIR/backend/.venv/bin/python" ]]; then
  echo "Backend environment is missing. Run ./scripts/bootstrap first." >&2
  exit 1
fi

"$ROOT_DIR/backend/.venv/bin/python" "$ROOT_DIR/backend/demo_flow.py" "$@"
