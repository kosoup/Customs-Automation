# ── KCS 수출신고 서버 환경설정 ────────────────────────────────────────────────

# Mock 모드 (true = 실제 UNI-PASS 미전송, false = 실전송)
MOCK_MODE=true

# UNI-PASS 환경 (test | production)
UNIPASS_ENV=test

# 관세청 발급 인증키 (실전송 시 필요)
# UNIPASS_AUTH_KEY=your_auth_key_here

# SSL 검증 (테스트 환경에서 인증서 문제 시 false 설정)
SSL_VERIFY=true

# Java 서명 서비스 포트
JAVA_SIGNER_PORT=8081

# FastAPI 서버 시작 시 Java 서비스 자동 시작 여부
AUTO_START_JAVA_SIGNER=false

# 로그 레벨 (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# CORS 허용 오리진 (콤마 구분)
# ALLOWED_ORIGINS=["http://localhost:3000","https://your-frontend.com"]
